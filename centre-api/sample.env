EPIC_ENGAGE_USER_MANAGEMENT_URL=

# Epic group names (Keycloak top-level group names)
EPIC_GROUP_COMPLIANCE=COMPLIANCE
EPIC_GROUP_CONDITION_REPO=CONDITION-REPO
EPIC_GROUP_SUBMIT=SUBMIT
EPIC_GROUP_TRACK=TRACK
EPIC_GROUP_ENGAGE=ENGAGE
EPIC_GROUP_CENTRE=CENTRE
EPIC_GROUP_PUBLIC=PUBLIC

# Epic admin subgroup names (Keycloak group names)
EPIC_ADMIN_SUBGROUP_ADMIN=ADMIN
EPIC_ADMIN_SUBGROUP_EAO_MANAGER=EAO_MANAGER
EPIC_ADMIN_SUBGROUP_INSTANCE_ADMIN=INSTANCE_ADMIN
EPIC_ADMIN_SUBGROUP_SUPERUSER=SUPERUSER
EPIC_ADMIN_SUBGROUP_SUPER_USER=SUPER_USER

# Epic admin group paths (Group/Subgroup)
EPIC_ADMIN_GROUP_PATH_COMPLIANCE=COMPLIANCE/SUPERUSER
EPIC_ADMIN_GROUP_PATH_CONDITION_REPO=CONDITION-REPO/ADMIN
EPIC_ADMIN_GROUP_PATH_SUBMIT=SUBMIT/EAO_MANAGER
EPIC_ADMIN_GROUP_PATH_TRACK=TRACK/INSTANCE_ADMIN
EPIC_ADMIN_GROUP_PATH_ENGAGE=ENGAGE/INSTANCE_ADMIN
EPIC_ADMIN_GROUP_PATH_CENTRE=CENTRE/SUPER_USER
EPIC_ADMIN_GROUP_PATH_PUBLIC=PUBLIC/ADMIN

# Epic app client names (Keycloak client IDs)
EPIC_APP_CLIENT_CONDITION_REPOSITORY=epic-condition
EPIC_APP_CLIENT_EPIC_COMPLIANCE=epic-compliance
EPIC_APP_CLIENT_EPIC_TRACK=epictrack-web
EPIC_APP_CLIENT_EPIC_PUBLIC=epic-public
EPIC_APP_CLIENT_EPIC_SUBMIT=epic-submit
EPIC_APP_CLIENT_EPIC_ENGAGE=epic-engage
EPIC_APP_CLIENT_EPIC_CENTRE=epic-centre